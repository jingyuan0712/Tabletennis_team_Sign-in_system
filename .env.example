# Copy to .env for local development; never commit the filled file.
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
DATABASE_PATH=./data/team.sqlite
PUBLIC_ORIGIN=http://localhost:5173
# Production requires a random value of at least 32 characters.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SECRET=
# Enable ONLY behind the included Caddy proxy; it replaces this client header.
TRUST_PROXY=false
# Production compose values; use your own domain and HTTPS origin.
DOMAIN=team.example.com

# GitHub Pages build only: public Worker origin, never a secret.
# Leave empty for the existing same-origin Node local development server.
VITE_API_BASE_URL=
# GitHub Actions sets this automatically for your repository.
VITE_BASE_PATH=/
