{
  "name": "table-tennis-today",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.worker.json",
    "start": "node --env-file-if-exists=.env dist-server/server/main.js",
    "scheduler": "node --env-file-if-exists=.env dist-server/server/scheduler.js",
    "db:migrate": "tsx --env-file-if-exists=.env server/migrate.ts",
    "cleanup": "tsx --env-file-if-exists=.env server/cleanup-cli.ts",
    "test": "tsx --test tests/core.test.ts",
    "test:e2e": "playwright test",
    "test:container": "node scripts/container-smoke.mjs",
    "test:cloudflare": "tsx --test tests/cloudflare.test.ts",
    "test:cloudflare:runtime": "node scripts/cloudflare-runtime-test.mjs",
    "test:pages:e2e": "node scripts/cloudflare-runtime-test.mjs --browser",
    "dev:cloudflare": "wrangler dev --local --test-scheduled",
    "db:cloudflare:local": "wrangler d1 migrations apply DB --local",
    "build:pages": "node scripts/build-pages.mjs",
    "cloudflare:check": "wrangler deploy --dry-run --outdir .cloudflare-build",
    "admin:configure": "node scripts/set-admin-password.mjs"
  },
  "dependencies": {
    "croner": "^9.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.151.0"
  }
}
